# Pinned tool, node image, and chart versions. Sourced by the Makefile.
# Bump deliberately, one line per change, and re-run `make down cluster smoke`.

# kind clusters: the demo app and its observability stack, and the Control plane
TARGET_CLUSTER=ic-target
CONTROL_PLANE_CLUSTER=ic-control-plane

# Tools (checked by `make tools`; minimum versions)
GO_MIN_VERSION=1.25
KIND_VERSION=v0.31.0
HELM_MIN_MAJOR=3
# What make demo installs on Linux, after asking, when a tool is missing
GO_VERSION=1.25.5
HELM_VERSION=v4.0.4
KUBECTL_VERSION=v1.35.0
GOLANGCI_LINT_VERSION=v2.13.2
# Optional, for make k9s: make tools warns but does not fail
K9S_MIN_VERSION=0.50

# Redaction rules: internal/redact/rules_gen.go is generated from this
# betterleaks release's config/betterleaks.toml by `make redact-rules`, which
# fails unless the release is this commit.
BETTERLEAKS_VERSION=v1.10.0
BETTERLEAKS_COMMIT=8d77e1712fb06fd14444cc648686f1d5655e28a8

# Kubernetes node image (kind v0.31.0 default)
KIND_NODE_IMAGE=kindest/node:v1.35.0@sha256:452d707d4862f52530247495d180205e029056831160e22870e37e3f6c1ac31f

# Helm charts
KPS_CHART_VERSION=91.4.1
LOKI_CHART_VERSION=7.3.0
ALLOY_CHART_VERSION=1.12.1
