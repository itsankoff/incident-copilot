# Pinned tool, node image, and chart versions. Sourced by the Makefile.
# Bump deliberately, one line per change, and re-run `make down cluster smoke`.

CLUSTER_NAME=incident-copilot

# Tools (checked by `make tools`; minimum versions)
GO_MIN_VERSION=1.24
KIND_VERSION=v0.31.0
HELM_MIN_MAJOR=3

# Kubernetes node image (kind v0.31.0 default)
KIND_NODE_IMAGE=kindest/node:v1.35.0@sha256:452d707d4862f52530247495d180205e029056831160e22870e37e3f6c1ac31f

# Helm charts
KPS_CHART_VERSION=91.4.1
LOKI_CHART_VERSION=7.3.0
ALLOY_CHART_VERSION=1.12.1
